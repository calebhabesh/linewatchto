{
	auto_https off
}

(linewatch_aws_lab_security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		X-Robots-Tag "noindex, nofollow, noarchive"
	}
}

(linewatch_cache_headers) {
	@linewatch_static_cache {
		path /_next/static/* /assets/*
	}
	header @linewatch_static_cache Cache-Control "public, max-age=31536000, immutable" {
		defer
	}

	@linewatch_train_marker_api_cache {
		path /api/trains /api/regional/trains
	}
	header @linewatch_train_marker_api_cache Cache-Control "public, max-age=0, s-maxage=4, stale-while-revalidate=4" {
		defer
	}

	@linewatch_station_api_no_store {
		path /api/stations/* /api/regional/stations/*
	}
	header @linewatch_station_api_no_store Cache-Control "no-store" {
		defer
	}

	# Live vehicles carry their own report times and are polled every 15 s: the train marker cadence.
	@linewatch_vehicle_position_api_cache {
		path /api/surface/streetcars/positions /api/surface/buses/positions /api/regional/buses/positions
	}
	header @linewatch_vehicle_position_api_cache Cache-Control "public, max-age=0, s-maxage=4, stale-while-revalidate=4" {
		defer
	}

	# Stop departures mix live and scheduled times per stop, like station arrivals.
	@linewatch_stop_api_no_store {
		path /api/surface/stops/* /api/regional/bus-stops/*
	}
	header @linewatch_stop_api_no_store Cache-Control "no-store" {
		defer
	}

	@linewatch_public_api_cache {
		path /api/dashboard /api/accessibility-outages /api/surface-notices /api/announcements /api/stations /api/alert-history /api/reliability/lines /api/reliability/stations/* /api/regional/trip-changes
		not path /api/stations/* /api/regional/stations/*
	}
	header @linewatch_public_api_cache Cache-Control "public, max-age=15, s-maxage=30, stale-while-revalidate=30" {
		defer
	}

	@linewatch_private_api_no_store {
		path /api/auth/* /api/account/* /api/admin/* /api/diagnostics/* /api/feedback /api/health* /api/actuator*
	}
	header @linewatch_private_api_no_store Cache-Control "no-store" {
		defer
	}
}

(linewatch_schedule_assets) {
	# Schedule-derived map and search files (plan 16): the schedule-assets service publishes them
	# into a volume mounted read-only at /srv/linewatch/data/schedule. Only the manifest and the
	# hashed JSON files are served; status, state and anything missing are a no-store 404, so a
	# missing hashed file is never cached as immutable. Without the volume every request is a 404
	# and the client uses the release's files.
	handle /data/schedule/* {
		root * /srv/linewatch
		@linewatch_schedule_manifest {
			path /data/schedule/manifest.json
			file
		}
		@linewatch_schedule_file {
			path_regexp ^/data/schedule/files/[A-Za-z0-9_-]+\.[0-9a-f]{16}\.json$
			file
		}
		header @linewatch_schedule_manifest Cache-Control "public, max-age=60"
		header @linewatch_schedule_file Cache-Control "public, max-age=31536000, immutable"
		handle @linewatch_schedule_manifest {
			file_server
		}
		handle @linewatch_schedule_file {
			file_server {
				precompressed br gzip
			}
		}
		handle {
			header Cache-Control "no-store"
			respond 404
		}
	}
}

:8080 {
	encode gzip zstd
	import linewatch_aws_lab_security_headers
	import linewatch_cache_headers
	import linewatch_schedule_assets

	handle /api/admin/* {
		respond 404
	}

	handle /api/diagnostics/raw-alerts/* {
		respond 404
	}

	handle /actuator* {
		respond 404
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
